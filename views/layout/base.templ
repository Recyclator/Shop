package layout

import (
	"github.com/nexora/backend/views/partials"
)

templ Base(title string, activeRoute string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="es">
		<head>
			<meta charset="UTF-8">
			<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
			<title>{ title }</title>
			<script>
				window.API_URL = '/api';
				window.token = localStorage.getItem('nexora_token');
				
				// Init theme immediately
				(function() {
					const userStr = localStorage.getItem('nexora_user');
					let theme = 'dark';
					if (userStr) {
						try {
							const user = JSON.parse(userStr);
							theme = user.theme || 'dark';
						} catch(e) {}
					} else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
						theme = 'light';
					}
					document.documentElement.setAttribute('data-theme', theme);
					window.currentTheme = theme;
				})();

				// Global Toggle Theme Function
				async function toggleTheme() {
					const html = document.documentElement;
					const current = html.getAttribute('data-theme');
					const next = current === 'light' ? 'dark' : 'light';
					
					console.log('Switching to theme:', next);
					html.setAttribute('data-theme', next);
					window.currentTheme = next;
					
					// Update local storage
					const userStr = localStorage.getItem('nexora_user');
					if (userStr) {
						try {
							const user = JSON.parse(userStr);
							user.theme = next;
							localStorage.setItem('nexora_user', JSON.stringify(user));
						} catch(e) {}
					}
					
					// Sync server
					if (window.token) {
						try {
							await fetch(window.API_URL + '/auth/theme', {
								method: 'PUT',
								headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + window.token },
								body: JSON.stringify({ theme: next })
							});
						} catch(e) {}
					}
				}
			</script>
			<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=DM+Sans:wght@400;500;600;700&family=DM+Mono&display=swap" rel="stylesheet">
			<link rel="stylesheet" href="/static/css/app-ui.css?v=1.0.1">
			<link rel="stylesheet" href="/static/css/app-main.css?v=1.0.1">
			<link rel="stylesheet" href="/static/css/app-components.css?v=1.0.1">
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<script src="/static/js/alpine.min.js" defer></script>
			<script src="/static/js/validator.js" defer></script>
		</head>
		<body>
			@partials.Sidebar(activeRoute)

			<div class="main-wrapper">
				@partials.Topbar(title)
				<main class="content">
					@content
				</main>
			</div>

			@partials.BottomNav(activeRoute)

			<script>
				// Auth guard
				(function() {
					if (!window.token && window.location.pathname !== '/') { 
						window.location.href = '/'; 
					}
				})();

				// User info display
				(function() {
					const userStr = localStorage.getItem('nexora_user');
					if (userStr) {
						try {
							const user = JSON.parse(userStr);
							const name = user.nombre || user.email;
							const nameEl = document.getElementById('user-name');
							const avatarEl = document.getElementById('user-avatar');
							if (nameEl) nameEl.textContent = name;
							if (avatarEl) avatarEl.textContent = name.charAt(0).toUpperCase();
						} catch(e) {}
					}
				})();

				// Logout
				function logout() {
					localStorage.removeItem('nexora_token');
					localStorage.removeItem('nexora_user');
					window.location.href = '/';
				}

				// Global 401 interceptor
				const _fetch = window.fetch;
				window.fetch = function(...args) {
					return _fetch.apply(this, args).then(res => {
						if (res.status === 401) {
							alert('Sesión expirada');
							logout();
						}
						return res;
					});
				};

				// HTMX Auth Token injection
				document.body.addEventListener('htmx:configRequest', function(evt) {
					const token = localStorage.getItem('nexora_token');
					if (token) {
						evt.detail.headers['Authorization'] = 'Bearer ' + token;
					}
				});

				// Custom dynamic confirm dialog component
				window.confirmDialog = function(options = {}) {
					return new Promise((resolve) => {
						const config = {
							title: '¿Confirmar acción?',
							message: '¿Estás seguro de realizar esta acción?',
							btnOkText: 'Aceptar',
							btnCancelText: 'Cancelar',
							type: 'danger', // 'danger' | 'warning' | 'success' | 'info'
							...options
						};

						// Theme variables mapping
						let iconColor = 'var(--danger)';
						let iconBg = 'rgba(239, 68, 68, 0.1)';
						let okBtnBg = 'var(--danger)';
						let iconSvg = '';

						if (config.type === 'danger') {
							iconColor = 'var(--danger)';
							iconBg = 'rgba(239, 68, 68, 0.1)';
							okBtnBg = 'var(--danger)';
							iconSvg = `<svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
							</svg>`;
						} else if (config.type === 'warning') {
							iconColor = '#f59e0b';
							iconBg = 'rgba(245, 158, 11, 0.1)';
							okBtnBg = '#f59e0b';
							iconSvg = `<svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
							</svg>`;
						} else if (config.type === 'success') {
							iconColor = 'var(--success)';
							iconBg = 'rgba(34, 197, 94, 0.1)';
							okBtnBg = 'var(--success)';
							iconSvg = `<svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>`;
						} else { // info
							iconColor = 'var(--accent)';
							iconBg = 'rgba(59, 130, 246, 0.1)';
							okBtnBg = 'var(--accent)';
							iconSvg = `<svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
								<path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
							</svg>`;
						}

						const modalId = 'confirm-dialog-' + Date.now();
						const overlay = document.createElement('div');
						overlay.id = modalId;
						overlay.className = 'modal-overlay';
						overlay.style.cssText = 'z-index: 9999; transition: opacity 0.2s ease; display: flex; opacity: 0; align-items: center; justify-content: center; backdrop-filter: blur(4px); background: rgba(0, 0, 0, 0.6); position: fixed; inset: 0;';

						overlay.innerHTML = `
							<div class="modal" style="max-width: 400px; transform: scale(0.9); transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease; opacity: 0; border: 1px solid var(--border-strong); box-shadow: 0 24px 38px 3px rgba(0,0,0,0.35), 0 9px 46px 8px rgba(0,0,0,0.25); border-radius: 16px;">
								<div class="modal-body" style="padding: 32px 24px; text-align: center;">
									<div style="width: 64px; height: 64px; background: ${iconBg}; color: ${iconColor}; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto; box-shadow: 0 0 0 8px rgba(255, 255, 255, 0.02);">
										${iconSvg}
									</div>
									<h3 style="font-size: 18px; font-weight: 700; color: var(--text); margin-bottom: 10px; letter-spacing: -0.2px; font-family: inherit;">${config.title}</h3>
									<p style="font-size: 14px; color: var(--text-sec); line-height: 1.5; margin-bottom: 28px; padding: 0 10px; font-family: inherit;">${config.message}</p>
									<div style="display: flex; gap: 12px; justify-content: center;">
										<button class="btn btn-secondary" id="${modalId}-cancel" style="flex: 1; height: 42px; border-radius: 10px; font-weight: 600; font-family: inherit;">${config.btnCancelText}</button>
										<button class="btn" id="${modalId}-ok" style="flex: 1; height: 42px; background: ${okBtnBg}; color: white; border-radius: 10px; font-weight: 600; font-family: inherit; border: none; transition: background-color 0.2s, filter 0.2s;">${config.btnOkText}</button>
									</div>
								</div>
							</div>
						`;

						document.body.appendChild(overlay);
						const box = overlay.querySelector('.modal');
						const okBtn = document.getElementById(`${modalId}-ok`);
						const cancelBtn = document.getElementById(`${modalId}-cancel`);

						function show() {
							overlay.offsetHeight; // force reflow
							overlay.style.opacity = '1';
							box.style.transform = 'scale(1)';
							box.style.opacity = '1';
						}

						function hide(result) {
							overlay.style.opacity = '0';
							box.style.transform = 'scale(0.9)';
							box.style.opacity = '0';
							document.removeEventListener('keydown', handleKeyDown);
							setTimeout(() => {
								overlay.remove();
								resolve(result);
							}, 200);
						}

						const handleKeyDown = (e) => {
							if (e.key === 'Escape') {
								hide(false);
							} else if (e.key === 'Enter') {
								hide(true);
							}
						};

						okBtn.onclick = () => hide(true);
						cancelBtn.onclick = () => hide(false);
						overlay.onclick = (e) => {
							if (e.target === overlay) hide(false);
						};
						document.addEventListener('keydown', handleKeyDown);

						okBtn.onmouseenter = () => okBtn.style.filter = 'brightness(0.9)';
						okBtn.onmouseleave = () => okBtn.style.filter = 'none';
						cancelBtn.onmouseenter = () => cancelBtn.style.filter = 'brightness(0.95)';
						cancelBtn.onmouseleave = () => cancelBtn.style.filter = 'none';

						show();
					});
				};

				// Keep confirmDelete as a wrapper for backwards compatibility
				window.confirmDelete = function(options = {}) {
					return window.confirmDialog({
						title: options.title || '¿Eliminar elemento?',
						message: options.message || 'Esta acción es permanente y no se podrá deshacer.',
						btnOkText: options.btnOkText || 'Eliminar',
						type: 'danger',
						...options
					});
				};
			</script>
		</body>
	</html>
}
