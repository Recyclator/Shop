package pages


// UsersData holds data for the users page
type UsersData struct {
	InitialPage int
}

// UsersPage renders the users management page
templ UsersPage(data UsersData) {
	<div class="page-header">
		<div>
			<h1 class="page-title">Usuarios</h1>
			<p class="page-sub" id="total-users">Cargando...</p>
		</div>
		<button class="btn btn-primary" onclick="openModal()">
			<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
			Nuevo Usuario
		</button>
	</div>

	<div class="toolbar">
		<input type="text" placeholder="Buscar por nombre, email..." id="search-filter">
		<select id="role-filter"><option value="">Todos los roles</option></select>
		<select id="status-filter"><option value="">Todos los estados</option><option value="true">Activo</option><option value="false">Inactivo</option></select>
		<button class="btn btn-secondary" onclick="loadUsers()">Filtrar</button>
	</div>

	<div class="card">
		<div class="card-body p-0">
			<table>
				<thead>
					<tr>
						<th>Nombre</th>
						<th>Email</th>
						<th>Teléfono</th>
						<th>Roles</th>
						<th>Estado</th>
						<th>Acciones</th>
					</tr>
				</thead>
				<tbody id="users-table">
					<tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text-mut)">Cargando usuarios...</td></tr>
				</tbody>
			</table>
		</div>
	</div>

	<div class="pagination" id="pagination"></div>

	<!-- Modal -->
	<div class="modal-overlay" id="user-modal">
		<div class="modal">
			<div class="modal-header">
				<div class="modal-title" id="modal-title">Nuevo Usuario</div>
				<button class="modal-close" onclick="closeModal()">&times;</button>
			</div>
			<div class="modal-body">
				<form id="user-form">
					<input type="hidden" id="user-id">
					<div class="form-row">
						<div class="form-group">
							<label class="form-label">Nombre *</label>
							<input type="text" class="form-input" id="nombre" required>
						</div>
						<div class="form-group">
							<label class="form-label">Apellido</label>
							<input type="text" class="form-input" id="apellido">
						</div>
					</div>
					<div class="form-group">
						<label class="form-label">Email *</label>
						<input type="email" class="form-input" id="email" required>
					</div>
					<div class="form-group" id="password-group">
						<label class="form-label">Contraseña *</label>
						<input type="password" class="form-input" id="password">
					</div>
					<div class="form-group">
						<label class="form-label">Teléfono</label>
						<input type="text" class="form-input" id="telefono">
					</div>
					<div class="form-group">
						<label class="form-label">Roles</label>
						<div class="checkbox-group" id="roles-list" style="display:flex;flex-wrap:wrap;gap:8px;max-height:150px;overflow-y:auto;padding:8px;background:var(--bg-surf);border-radius:8px;"></div>
					</div>
					<div class="form-group" id="activo-group" style="display:none;">
						<label class="form-label">Estado</label>
						<select class="form-select" id="activo"><option value="true">Activo</option><option value="false">Inactivo</option></select>
					</div>
				</form>
			</div>
			<div class="modal-footer">
				<button class="btn btn-secondary" onclick="closeModal()">Cancelar</button>
				<button class="btn btn-primary" onclick="saveUser()">Guardar</button>
			</div>
		</div>
	</div>

	<script src="/public/toast.js"></script>
	<script>
		let currentPage = 1, currentSearch = '', currentRole = '', currentStatus = '';
		let allRoles = [];

		async function loadUsers(page = 1) {
			currentPage = page;
			try {
				let url = `${API_URL}/users?page=${page}&limit=20`;
				if (currentSearch) url += '&search=' + encodeURIComponent(currentSearch);
				if (currentRole) url += '&role=' + encodeURIComponent(currentRole);
				if (currentStatus) url += '&activo=' + currentStatus;
				const res = await fetch(url, { headers: { 'Authorization': 'Bearer ' + token } });
				if (res.ok) {
					const data = await res.json();
					const users = data.data || [];
					const meta = data.meta || {};
					renderUsers(users);
					renderPagination(meta);
					document.getElementById('total-users').textContent = `${meta.total || 0} usuarios registrados`;
				}
			} catch (e) { Toast.error('Error', 'Error de conexión'); }
		}

		function renderUsers(users) {
			const tbody = document.getElementById('users-table');
			if (users.length === 0) { tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text-mut)">No hay usuarios</td></tr>'; return; }
			tbody.innerHTML = users.map(u => {
				const roles = (u.roles || []).map(r => `<span class="badge badge-blue">${r.display_name || r.nombre}</span>`).join(' ');
				return `<tr>
					<td style="font-weight:500;color:var(--text)">${u.nombre} ${u.apellido || ''}</td>
					<td>${u.email}</td><td>${u.telefono || '-'}</td><td>${roles || '-'}</td>
					<td><span class="badge ${u.activo ? 'badge-green' : 'badge-red'}">${u.activo ? 'Activo' : 'Inactivo'}</span></td>
					<td><div class="actions">
						<button class="action-btn" onclick="editUser(${u.id})" title="Editar"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
						<button class="action-btn" onclick="deleteUser(${u.id})" title="Eliminar"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline x1="3" y1="6" x2="21" y2="6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
					</div></td>
				</tr>`;
			}).join('');
		}

		function renderPagination(meta) {
			const totalPages = meta.total_pages || 1;
			if (totalPages <= 1) { document.getElementById('pagination').innerHTML = ''; return; }
			let html = `<div class="pagination-info">Mostrando ${((currentPage - 1) * 20) + 1}-${Math.min(currentPage * 20, meta.total)} de ${meta.total}</div>`;
			html += '<div class="pagination-buttons">';
			if (currentPage > 1) html += `<button class="btn btn-sm btn-secondary" onclick="loadUsers(${currentPage - 1})">Anterior</button>`;
			if (currentPage < totalPages) html += `<button class="btn btn-sm btn-secondary" onclick="loadUsers(${currentPage + 1})">Siguiente</button>`;
			html += '</div>';
			document.getElementById('pagination').innerHTML = html;
		}

		async function loadRoles() {
			try {
				const res = await fetch(`${API_URL}/roles`, { headers: { 'Authorization': 'Bearer ' + token } });
				if (res.ok) {
					const data = await res.json();
					allRoles = data.data || [];
					document.getElementById('role-filter').innerHTML = '<option value="">Todos los roles</option>' + allRoles.map(r => `<option value="${r.nombre}">${r.display_name}</option>`).join('');
				}
			} catch (e) {}
		}

		function openModal() {
			document.getElementById('modal-title').textContent = 'Nuevo Usuario';
			document.getElementById('user-form').reset();
			document.getElementById('user-id').value = '';
			document.getElementById('password-group').style.display = 'block';
			document.getElementById('activo-group').style.display = 'none';
			renderRolesCheckboxes();
			document.getElementById('user-modal').classList.add('active');
		}

		function closeModal() { document.getElementById('user-modal').classList.remove('active'); }

		function renderRolesCheckboxes() {
			document.getElementById('roles-list').innerHTML = allRoles.map(r => `<label style="display:flex;align-items:center;gap:6px;font-size:12px;"><input type="checkbox" value="${r.id}" data-role="${r.nombre}">${r.display_name}</label>`).join('');
		}

		async function editUser(id) {
			try {
				const res = await fetch(`${API_URL}/users/${id}`, { headers: { 'Authorization': 'Bearer ' + token } });
				if (res.ok) {
					const data = await res.json();
					const u = data.data;
					document.getElementById('modal-title').textContent = 'Editar Usuario';
					document.getElementById('user-id').value = u.id;
					document.getElementById('nombre').value = u.nombre;
					document.getElementById('apellido').value = u.apellido || '';
					document.getElementById('email').value = u.email;
					document.getElementById('telefono').value = u.telefono || '';
					document.getElementById('password-group').style.display = 'none';
					document.getElementById('activo-group').style.display = 'block';
					document.getElementById('activo').value = u.activo.toString();
					renderRolesCheckboxes();
					if (u.roles) u.roles.forEach(role => { const cb = document.querySelector(`input[data-role="${role.nombre}"]`); if (cb) cb.checked = true; });
					document.getElementById('user-modal').classList.add('active');
				}
			} catch (e) { Toast.error('Error', 'No se pudo cargar el usuario'); }
		}

		async function saveUser() {
			const id = document.getElementById('user-id').value;
			const body = {
				nombre: document.getElementById('nombre').value.trim(),
				apellido: document.getElementById('apellido').value.trim(),
				email: document.getElementById('email').value.trim(),
				telefono: document.getElementById('telefono').value.trim(),
				role_ids: Array.from(document.querySelectorAll('#roles-list input:checked')).map(cb => parseInt(cb.value))
			};
			const password = document.getElementById('password').value;
			if (!body.nombre || !body.email) { Toast.warning('Campos requeridos', 'Nombre y email son obligatorios'); return; }
			if (!id && !password) { Toast.warning('Contraseña requerida', 'La contraseña es obligatoria para nuevos usuarios'); return; }
			if (password) body.password = password;
			try {
				const res = await fetch(id ? `${API_URL}/users/${id}` : `${API_URL}/users`, {
					method: id ? 'PUT' : 'POST',
					headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' },
					body: JSON.stringify(body)
				});
				const data = await res.json();
				if (res.ok) { Toast.success('Éxito', id ? 'Usuario actualizado' : 'Usuario creado'); closeModal(); loadUsers(currentPage); }
				else { Toast.error('Error', data.error?.message || 'Error al guardar'); }
			} catch (e) { Toast.error('Error', 'Error de conexión'); }
		}

		async function deleteUser(id) {
			if (!confirm('¿Estás seguro de eliminar este usuario?')) return;
			try {
				const res = await fetch(`${API_URL}/users/${id}`, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token } });
				const data = await res.json();
				if (res.ok) { Toast.success('Éxito', 'Usuario eliminado'); loadUsers(currentPage); }
				else { Toast.error('Error', data.error?.message || 'Error al eliminar'); }
			} catch (e) { Toast.error('Error', 'Error de conexión'); }
		}

		document.getElementById('search-filter').addEventListener('keypress', (e) => { if (e.key === 'Enter') { currentSearch = e.target.value; loadUsers(1); } });
		document.getElementById('role-filter').addEventListener('change', (e) => { currentRole = e.target.value; loadUsers(1); });
		document.getElementById('status-filter').addEventListener('change', (e) => { currentStatus = e.target.value; loadUsers(1); });

		loadUsers(1); loadRoles();
	</script>
}
