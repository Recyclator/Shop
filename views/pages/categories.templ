package pages


// CategoriesPage renders the categories management page
templ CategoriesPage() {
	<div class="page-header">
		<div>
			<h1 class="page-title">Categorías</h1>
			<p class="page-sub" id="total-categories">Cargando...</p>
		</div>
		<button class="btn btn-primary" onclick="openModal()">
			<svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
			Nueva Categoría
		</button>
	</div>

	<div class="card">
		<div class="card-body p-0">
			<table>
				<thead><tr><th>Nombre</th><th>Descripción</th><th>Productos</th><th>Estado</th><th>Acciones</th></tr></thead>
				<tbody id="categories-table"><tr><td colspan="5" style="text-align:center;padding:40px;color:var(--text-mut)">Cargando categorías...</td></tr></tbody>
			</table>
		</div>
	</div>

	<!-- Category Modal -->
	<div class="modal-overlay" id="category-modal">
		<div class="modal">
			<div class="modal-header">
				<div class="modal-title" id="modal-title">Nueva Categoría</div>
				<button class="modal-close" onclick="closeModal()">&times;</button>
			</div>
			<div class="modal-body">
				<form id="category-form">
					<input type="hidden" id="category-id">
					<div class="form-group"><label class="form-label">Nombre *</label><input type="text" class="form-input" id="category-nombre" required></div>
					<div class="form-group"><label class="form-label">Descripción</label><textarea class="form-input" id="category-descripcion" rows="3" style="height:auto"></textarea></div>
					<div class="form-row">
						<div class="form-group"><label class="form-label">Categoría Padre</label><select class="form-select" id="category-padre"><option value="">Ninguna</option></select></div>
						<div class="form-group"><label class="form-label">Orden</label><input type="number" class="form-input" id="category-orden" value="0" min="0"></div>
					</div>
					<div class="form-row">
						<div class="form-group"><label class="form-label">Activa</label><select class="form-select" id="category-activa"><option value="true">Sí</option><option value="false">No</option></select></div>
						<div class="form-group"><label class="form-label">Mostrar en menú</label><select class="form-select" id="category-mostrar-menu"><option value="true">Sí</option><option value="false">No</option></select></div>
					</div>
				</form>
			</div>
			<div class="modal-footer">
				<button class="btn btn-secondary" onclick="closeModal()">Cancelar</button>
				<button class="btn btn-primary" onclick="saveCategory()">Guardar</button>
			</div>
		</div>
	</div>

	<script src="/static/js/toast.js"></script>
	<script>
		let categories = [];
		async function loadCategories() {
			try {
				const res = await fetch(`${API_URL}/categories`, { headers: { 'Authorization': 'Bearer ' + token } });
				if (res.ok) {
					categories = (await res.json()).data || [];
					renderCategories(categories);
					document.getElementById('total-categories').textContent = `${categories.length} categorías`;
					loadParentOptions();
				}
			} catch (e) { Toast.error('Error', 'Error de conexión'); }
		}
		function renderCategories(list) {
			const tbody = document.getElementById('categories-table');
			if (list.length === 0) { tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;padding:40px;color:var(--text-mut)">No hay categorías</td></tr>'; return; }
			tbody.innerHTML = list.map(c => `<tr>
				<td style="font-weight:500;color:var(--text)">${c.nombre}</td>
				<td>${c.descripcion || '-'}</td>
				<td>${c.productos?.length || 0}</td>
				<td><span class="badge ${c.activa ? 'badge-green' : 'badge-gray'}">${c.activa ? 'Activa' : 'Inactiva'}</span></td>
				<td><div class="actions">
					<button class="action-btn" onclick="editCategory(${c.id})" title="Editar"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
					<button class="action-btn" onclick="deleteCategory(${c.id})" title="Eliminar"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><polyline x1="3" y1="6" x2="21" y2="6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
				</div></td>
			</tr>`).join('');
		}
		function loadParentOptions() {
			document.getElementById('category-padre').innerHTML = '<option value="">Ninguna</option>' + categories.map(c => `<option value="${c.id}">${c.nombre}</option>`).join('');
		}
		function openModal() { document.getElementById('modal-title').textContent = 'Nueva Categoría'; document.getElementById('category-form').reset(); document.getElementById('category-id').value = ''; document.getElementById('category-modal').classList.add('active'); }
		function closeModal() { document.getElementById('category-modal').classList.remove('active'); }
		async function editCategory(id) {
			try {
				const res = await fetch(`${API_URL}/categories/${id}`, { headers: { 'Authorization': 'Bearer ' + token } });
				if (res.ok) { const c = (await res.json()).data; document.getElementById('modal-title').textContent = 'Editar Categoría'; document.getElementById('category-id').value = c.id; document.getElementById('category-nombre').value = c.nombre; document.getElementById('category-descripcion').value = c.descripcion || ''; document.getElementById('category-padre').value = c.padre_id || ''; document.getElementById('category-orden').value = c.orden; document.getElementById('category-activa').value = c.activa.toString(); document.getElementById('category-mostrar-menu').value = c.mostrar_menu.toString(); document.getElementById('category-modal').classList.add('active'); }
			} catch (e) { Toast.error('Error', 'No se pudo cargar la categoría'); }
		}
		async function saveCategory() {
			if (!FormValidator.validateForm('category-form')) return;
			const id = document.getElementById('category-id').value;
			const payload = { nombre: document.getElementById('category-nombre').value, descripcion: document.getElementById('category-descripcion').value, padre_id: document.getElementById('category-padre').value ? parseInt(document.getElementById('category-padre').value) : null, orden: parseInt(document.getElementById('category-orden').value) || 0, activa: document.getElementById('category-activa').value === 'true', mostrar_menu: document.getElementById('category-mostrar-menu').value === 'true' };
			try {
				const res = await fetch(id ? `${API_URL}/categories/${id}` : `${API_URL}/categories`, { method: id ? 'PUT' : 'POST', headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
				const data = await res.json();
				if (res.ok) { Toast.success('Éxito', id ? 'Categoría actualizada' : 'Categoría creada'); closeModal(); loadCategories(); }
				else { Toast.error('Error', data.error?.message || 'Error al guardar'); }
			} catch (e) { Toast.error('Error', 'Error de conexión'); }
		}
		async function deleteCategory(id) {
			if (!(await window.confirmDelete({ title: '¿Eliminar categoría?', message: '¿Estás seguro de que deseas eliminar esta categoría?' }))) return;
			try {
				const res = await fetch(`${API_URL}/categories/${id}`, { method: 'DELETE', headers: { 'Authorization': 'Bearer ' + token } });
				if (res.ok) { Toast.success('Éxito', 'Categoría eliminada'); loadCategories(); }
				else { Toast.error('Error', (await res.json()).error?.message || 'Error al eliminar'); }
			} catch (e) { Toast.error('Error', 'Error de conexión'); }
		}
		loadCategories();
	</script>
}
