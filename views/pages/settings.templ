package pages

// SettingsPage renders the settings page
templ SettingsPage() {
	<div class="page-header">
		<h1 class="page-title">Configuración</h1>
		<p class="page-sub">Administra la configuración de tu tienda</p>
	</div>

	<div style="display:grid;gap:16px;">
		<!-- Roles y Permisos -->
		<div class="card" style="cursor:pointer;" onclick="location.href='/roles-permissions'">
			<div class="card-body" style="display:flex;align-items:center;gap:16px;padding:20px;">
				<div style="width:40px;height:40px;background:var(--accent-dim);border-radius:10px;display:flex;align-items:center;justify-content:center;color:var(--accent);">
					<svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
				</div>
				<div><div style="font-weight:600;">Roles y Permisos</div><div style="font-size:12px;color:var(--text-mut);">Gestión de roles y permisos del sistema</div></div>
			</div>
		</div>
		<div class="card">
			<div class="card-body" style="padding:20px;">
				<div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
					<div style="width:36px;height:36px;background:var(--accent-dim);border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--accent);"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div>
					<div><div style="font-weight:600;">Empresa</div><div style="font-size:12px;color:var(--text-mut);">Información legal</div></div>
				</div>
				<div class="form-row">
					<div class="form-group"><label class="form-label">Nombre</label><input type="text" class="form-input" id="company-name" value="Nexora SAS"></div>
					<div class="form-row">
						<div class="form-group"><label class="form-label">NIT</label><input type="text" class="form-input" id="company-nit" value="1234567890"></div>
						<div class="form-group"><label class="form-label">DV</label><input type="text" class="form-input" id="company-dv" value="1"></div>
					</div>
				</div>
				<div class="form-group"><label class="form-label">Dirección</label><input type="text" class="form-input" id="company-address" value="Carrera 10 # 20-30"></div>
				<div class="form-row">
					<div class="form-group"><label class="form-label">Ciudad</label><input type="text" class="form-input" id="company-city" value="Bogotá"></div>
					<div class="form-group"><label class="form-label">Teléfono</label><input type="text" class="form-input" id="company-phone" value="+57 1 234 5678"></div>
				</div>
				<button class="btn btn-primary" onclick="saveCompany()">Guardar</button>
			</div>
		</div>

		<!-- Estadísticas -->
		<div class="card">
			<div class="card-body" style="padding:20px;">
				<div style="display:flex;align-items:center;gap:12px;margin-bottom:16px;">
					<div style="width:36px;height:36px;background:var(--success-dim);border-radius:8px;display:flex;align-items:center;justify-content:center;color:var(--success);"><svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
					<div><div style="font-weight:600;">Usuarios y Roles</div><div style="font-size:12px;color:var(--text-mut);">Estadísticas del sistema</div></div>
				</div>
				<div id="stats-info" style="font-size:13px;color:var(--text-sec);">Cargando...</div>
				<div style="margin-top:12px;"><button class="btn btn-secondary" onclick="location.href='/users'">Ver usuarios</button></div>
			</div>
		</div>
	</div>

	<script src="/public/toast.js"></script>
	<script>
		function saveCompany() { Toast.success('Éxito', 'Configuración guardada'); }
		async function loadStats() {
			try {
				const res = await fetch(`${API_URL}/users?limit=1`, { headers: { 'Authorization': 'Bearer ' + token } });
				if (res.ok) {
					const data = await res.json();
					document.getElementById('stats-info').innerHTML = `<div style="display:flex;gap:24px;"><div><strong>${data.meta?.total || 0}</strong> usuarios totales</div></div>`;
				}
			} catch (e) {}
		}
		loadStats();
	</script>
}
