package pages


// ProfilePage renders the user profile page
templ ProfilePage() {
	<div class="page-header">
		<div>
			<h1 class="page-title">Perfil</h1>
			<p class="page-sub">Gestiona tu información personal y seguridad</p>
		</div>
	</div>

	<div class="profile-header-card" style="background:var(--bg-elev);border:1px solid var(--border);border-radius:12px;padding:24px;display:flex;align-items:center;gap:20px;margin-bottom:24px;">
		<div style="width:64px;height:64px;background:linear-gradient(135deg,#3b82f6,#8b5cf6);border-radius:16px;display:flex;align-items:center;justify-content:center;font-size:24px;font-weight:700;" id="header-avatar">?</div>
		<div>
			<div style="font-size:20px;font-weight:600;" id="header-name">Cargando...</div>
			<div style="font-size:13px;color:var(--text-mut);" id="header-email"></div>
		</div>
	</div>

	<div x-data="{ tab: 'personal' }">
		<div class="tabs" style="display:flex;gap:8px;margin-bottom:24px;border-bottom:1px solid var(--border);padding-bottom:8px;">
			<button class="tab-btn" :class="{ 'active': tab === 'personal' }" @click="tab = 'personal'" style="padding:8px 16px;border-radius:8px;border:none;background:var(--tab === 'personal' ? 'var(--accent-dim)' : 'transparent');color:var(--tab === 'personal' ? 'var(--accent)' : 'var(--text-sec)');cursor:pointer;font-size:13px;font-weight:500;">Personal</button>
			<button class="tab-btn" :class="{ 'active': tab === 'security' }" @click="tab = 'security'" style="padding:8px 16px;border-radius:8px;border:none;background:var(--tab === 'security' ? 'var(--accent-dim)' : 'transparent');color:var(--tab === 'security' ? 'var(--accent)' : 'var(--text-sec)');cursor:pointer;font-size:13px;font-weight:500;">Seguridad</button>
		</div>

		<!-- Personal Tab -->
		<div x-show="tab === 'personal" class="card">
			<div class="card-body">
				<form id="profile-form" @submit.prevent="submitProfile">
					<div class="form-row">
						<div class="form-group"><label class="form-label">Nombre</label><input type="text" class="form-input" id="prof-nombre"></div>
						<div class="form-group"><label class="form-label">Apellido</label><input type="text" class="form-input" id="prof-apellido"></div>
					</div>
					<div class="form-group"><label class="form-label">Teléfono</label><input type="text" class="form-input" id="prof-telefono"></div>
					<div class="form-row">
						<div class="form-group"><label class="form-label">Tipo Documento</label><select class="form-select" id="prof-tipo-documento"><option value="CC">CC</option><option value="CE">CE</option><option value="NIT">NIT</option></select></div>
						<div class="form-group"><label class="form-label">Número Documento</label><input type="text" class="form-input" id="prof-numero-documento"></div>
					</div>
					<div class="form-group"><label class="form-label">Dirección</label><input type="text" class="form-input" id="prof-direccion"></div>
					<div class="form-row">
						<div class="form-group"><label class="form-label">Ciudad</label><input type="text" class="form-input" id="prof-ciudad"></div>
						<div class="form-group"><label class="form-label">Departamento</label><input type="text" class="form-input" id="prof-departamento"></div>
					</div>
					<div class="form-row">
						<div class="form-group"><label class="form-label">País</label><select class="form-select" id="prof-pais"><option value="CO">Colombia</option><option value="VE">Venezuela</option><option value="EC">Ecuador</option></select></div>
						<div class="form-group"><label class="form-label">Código Postal</label><input type="text" class="form-input" id="prof-codigo-postal"></div>
					</div>
					<button type="submit" class="btn btn-primary" id="profile-save-btn">Guardar Cambios</button>
					<div id="profile-msg" style="margin-top:12px;font-size:12px;"></div>
				</form>
			</div>
		</div>

		<!-- Security Tab -->
		<div x-show="tab === 'security'" class="card">
			<div class="card-body">
				<form id="password-form" @submit.prevent="submitPassword">
					<div class="form-group"><label class="form-label">Contraseña Actual *</label><input type="password" class="form-input" id="pwd-current" required></div>
					<div class="form-group"><label class="form-label">Nueva Contraseña *</label><input type="password" class="form-input" id="pwd-new" required></div>
					<div class="form-group"><label class="form-label">Confirmar Contraseña *</label><input type="password" class="form-input" id="pwd-confirm" required></div>
					<button type="submit" class="btn btn-primary">Cambiar Contraseña</button>
					<div id="password-msg" style="margin-top:12px;font-size:12px;"></div>
				</form>
			</div>
		</div>
	</div>

	<script src="/public/toast.js"></script>
	<script>
		async function loadProfile() {
			try {
				const res = await fetch(`${API_URL}/auth/profile`, { headers: { 'Authorization': 'Bearer ' + token } });
				if (res.ok) {
					const u = (await res.json()).data;
					document.getElementById('header-name').textContent = u.nombre + (u.apellido ? ' ' + u.apellido : '');
					document.getElementById('header-email').textContent = u.email;
					document.getElementById('header-avatar').textContent = (u.nombre || '?').charAt(0).toUpperCase();
					document.getElementById('prof-nombre').value = u.nombre || '';
					document.getElementById('prof-apellido').value = u.apellido || '';
					document.getElementById('prof-telefono').value = u.telefono || '';
					document.getElementById('prof-tipo-documento').value = u.tipo_documento || 'CC';
					document.getElementById('prof-numero-documento').value = u.numero_documento || '';
					document.getElementById('prof-direccion').value = u.direccion || '';
					document.getElementById('prof-ciudad').value = u.ciudad || '';
					document.getElementById('prof-departamento').value = u.departamento || '';
					document.getElementById('prof-pais').value = u.pais || 'CO';
					document.getElementById('prof-codigo-postal').value = u.codigo_postal || '';
				}
			} catch (e) {}
		}
		document.getElementById('profile-form').addEventListener('submit', async (e) => {
			e.preventDefault();
			const btn = document.getElementById('profile-save-btn');
			const msg = document.getElementById('profile-msg');
			btn.textContent = 'Guardando...'; btn.disabled = true;
			try {
				const res = await fetch(`${API_URL}/auth/profile`, { method: 'PUT', headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' }, body: JSON.stringify({ nombre: document.getElementById('prof-nombre').value, apellido: document.getElementById('prof-apellido').value, telefono: document.getElementById('prof-telefono').value, tipo_documento: document.getElementById('prof-tipo-documento').value, numero_documento: document.getElementById('prof-numero-documento').value, direccion: document.getElementById('prof-direccion').value, ciudad: document.getElementById('prof-ciudad').value, departamento: document.getElementById('prof-departamento').value, pais: document.getElementById('prof-pais').value, codigo_postal: document.getElementById('prof-codigo-postal').value }) });
				if (res.ok) { msg.style.color = 'var(--success)'; msg.textContent = 'Perfil actualizado'; Toast.success('Éxito', 'Perfil actualizado'); }
				else { msg.style.color = 'var(--danger)'; msg.textContent = 'Error al actualizar'; }
			} catch (e) { msg.textContent = 'Error de conexión'; }
			btn.textContent = 'Guardar Cambios'; btn.disabled = false;
		});
		document.getElementById('password-form').addEventListener('submit', async (e) => {
			e.preventDefault();
			const msg = document.getElementById('password-msg');
			const current = document.getElementById('pwd-current').value;
			const newPwd = document.getElementById('pwd-new').value;
			const confirm = document.getElementById('pwd-confirm').value;
			if (newPwd !== confirm) { msg.style.color = 'var(--danger)'; msg.textContent = 'Las contraseñas no coinciden'; return; }
			try {
				const res = await fetch(`${API_URL}/auth/change-password`, { method: 'POST', headers: { 'Authorization': 'Bearer ' + token, 'Content-Type': 'application/json' }, body: JSON.stringify({ current_password: current, new_password: newPwd, confirm_password: confirm }) });
				if (res.ok) { msg.style.color = 'var(--success)'; msg.textContent = 'Contraseña actualizada'; Toast.success('Éxito', 'Contraseña cambiada'); document.getElementById('password-form').reset(); }
				else { msg.style.color = 'var(--danger)'; msg.textContent = (await res.json()).error?.message || 'Error'; }
			} catch (e) { msg.textContent = 'Error de conexión'; }
		});
		loadProfile();
	</script>
}
