package pages


// RolesPermissionsPage renders the roles and permissions management page
templ RolesPermissionsPage() {
	<div class="page-header">
		<div><h1 class="page-title">Roles y Permisos</h1><p class="page-sub">Gestión de roles y permisos (solo superadmin)</p></div>
		<button class="btn btn-primary" onclick="openRoleModal()"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Nuevo Rol</button>
	</div>
	<div class="card"><div class="card-body p-0">
		<table><thead><tr><th>Rol</th><th>Nivel</th><th>Permisos</th><th>Usuarios</th><th>Estado</th><th>Acciones</th></tr></thead>
		<tbody id="roles-table"><tr><td colspan="6" style="text-align:center;padding:40px;color:var(--text-mut)">Cargando...</td></tr></tbody></table>
	</div></div>
	<div class="card" style="margin-top:24px"><div class="card-header"><div class="card-title">Todos los Permisos</div></div>
		<div class="card-body"><div id="all-permissions-list"></div></div>
	</div>
	<div class="modal-overlay" id="role-modal"><div class="modal">
		<div class="modal-header"><div class="modal-title" id="role-modal-title">Nuevo Rol</div><button class="modal-close" onclick="closeRoleModal()">&times;</button></div>
		<div class="modal-body"><form id="role-form">
			<input type="hidden" id="role-id">
			<div class="form-row"><div class="form-group"><label class="form-label">Nombre (código) *</label><input type="text" class="form-input" id="role-nombre" required></div><div class="form-group"><label class="form-label">Nombre visible *</label><input type="text" class="form-input" id="role-display" required></div></div>
			<div class="form-group"><label class="form-label">Descripción</label><input type="text" class="form-input" id="role-desc"></div>
			<div class="form-group"><label class="form-label">Nivel</label><input type="number" class="form-input" id="role-level" value="50" min="1" max="100"></div>
			<div class="form-group"><label class="form-label">Permisos</label><div id="permissions-list" style="max-height:300px;overflow-y:auto;"></div></div>
		</form></div>
		<div class="modal-footer"><button class="btn btn-secondary" onclick="closeRoleModal()">Cancelar</button><button class="btn btn-primary" onclick="saveRole()">Guardar</button></div>
	</div></div>
	<script src="/static/js/toast.js"></script>
	<script src="/static/js/roles-permissions.js"></script>
}
