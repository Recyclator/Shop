package pages

// POSPage renders the Point of Sale page
templ POSPage() {
	<div class="page-header"><h1 class="page-title">Punto de Venta</h1><p class="page-sub">Registra ventas rápidamente</p></div>

	<div x-data="{ view: 'products' }">
		<div class="pos-tabs" style="display:flex;gap:8px;margin-bottom:20px;border-bottom:1px solid var(--border);padding-bottom:8px;">
			<button class="btn" @click="view = 'products'" :class="view === 'products' ? 'btn-primary' : 'btn-secondary'">Productos</button>
			<button class="btn" @click="view = 'cart'" :class="view === 'cart' ? 'btn-primary' : 'btn-secondary'">Carrito <span id="cart-count">(0)</span></button>
			<button class="btn" @click="view = 'sales'; loadPOSSales()" :class="view === 'sales' ? 'btn-primary' : 'btn-secondary'">Historial</button>
		</div>

		<!-- Products View -->
		<div x-show="view === 'products'">
			<div class="toolbar"><input type="text" class="form-input" placeholder="Buscar productos..." id="pos-search" @input="searchPOSProducts()"><input type="text" class="form-input" placeholder="Código de barras..." id="pos-barcode" @keyup.enter="scanBarcode()"></div>
			<div id="pos-products-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;">
				<div style="text-align:center;padding:40px;color:var(--text-mut);grid-column:1/-1;">Cargando productos...</div>
			</div>
		</div>

		<!-- Cart View -->
		<div x-show="view === 'cart'">
			<div class="card"><div class="card-body">
				<div id="cart-items"><div style="text-align:center;padding:40px;color:var(--text-mut)">Carrito vacío</div></div>
				<div style="border-top:1px solid var(--border);padding-top:12px;margin-top:12px;">
					<div style="display:flex;justify-content:space-between;margin-bottom:8px;"><span>Subtotal</span><span class="mono" id="cart-subtotal">$0</span></div>
					<div style="display:flex;justify-content:space-between;font-size:18px;font-weight:600;"><span>Total</span><span class="mono" id="cart-total">$0</span></div>
				</div>
				<div style="margin-top:16px;display:flex;gap:8px;flex-wrap:wrap;">
					<button class="btn btn-primary" onclick="completePOSSale('efectivo')">Efectivo</button>
					<button class="btn btn-secondary" onclick="completePOSSale('tarjeta')">Tarjeta</button>
					<button class="btn btn-secondary" onclick="completePOSSale('transferencia')">Transferencia</button>
				</div>
			</div></div>
		</div>

		<!-- Sales History View -->
		<div x-show="view === 'sales'">
			<div class="toolbar"><select id="sales-period"><option value="today">Hoy</option><option value="week">Semana</option><option value="month">Mes</option><option value="all">Todo</option></select><button class="btn btn-secondary" onclick="loadPOSSales()">Filtrar</button></div>
			<div class="card"><div class="card-body p-0">
				<table><thead><tr><th>Orden</th><th>Hora</th><th>Items</th><th>Total</th><th>Método</th></tr></thead>
				<tbody id="sales-tbody"><tr><td colspan="5" style="text-align:center;padding:40px;color:var(--text-mut)">Cargando...</td></tr></tbody></table>
			</div></div>
		</div>
	</div>

	<script src="/static/js/toast.js"></script>
	<script src="/static/js/pos.js"></script>
}
