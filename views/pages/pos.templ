package pages

// POSPage renders the Point of Sale page
templ POSPage() {
	<div class="pos-container" style="display: flex; gap: 24px; height: calc(100vh - 110px); position: relative; overflow: hidden; margin-top: -10px;">
		<!-- LEFT PANE: Product Catalog -->
		<div class="pos-catalog" style="flex: 7; display: flex; flex-direction: column; height: 100%; overflow: hidden;">
			<!-- Search & Scanner status -->
			<div class="toolbar" style="display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 16px; padding: 12px 16px; flex-wrap: nowrap;">
				<div style="flex: 1; position: relative; display: flex; align-items: center;">
					<svg style="position: absolute; left: 14px; width: 18px; height: 18px; color: var(--text-mut);" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
					</svg>
					<input type="text" class="form-input" placeholder="Buscar productos por nombre, SKU o categoría..." id="pos-search" oninput="searchPOSProducts()" style="padding-left: 44px; width: 100% !important; margin: 0;">
				</div>
				<div id="scanner-status" style="display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; padding: 8px 12px; border-radius: 20px; background: rgba(34, 197, 94, 0.1); color: var(--success); border: 1px solid rgba(34, 197, 94, 0.2); white-space: nowrap; flex-shrink: 0;">
					<span style="width: 8px; height: 8px; border-radius: 50%; background: var(--success); display: inline-block; animation: pulse 1.5s infinite;"></span>
					Escáner Activo
				</div>
			</div>

			<!-- Categories -->
			<div id="pos-categories" style="display: flex; gap: 8px; margin-bottom: 16px; overflow-x: auto; padding-bottom: 4px; scrollbar-width: none; -ms-overflow-style: none;">
				<!-- JavaScript will populate categories here -->
			</div>

			<!-- Products Grid -->
			<div id="pos-products-grid" style="flex: 1; display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 16px; overflow-y: auto; padding-right: 4px;">
				<div style="text-align: center; padding: 60px; color: var(--text-mut); grid-column: 1/-1;">
					<div class="loader" style="margin: 0 auto 16px auto; border: 3px solid var(--border); border-top: 3px solid var(--accent); border-radius: 50%; width: 32px; height: 32px; animation: spin 1s linear infinite;"></div>
					Cargando catálogo de productos...
				</div>
			</div>
		</div>

		<!-- RIGHT PANE: Cart & Checkout (Sticky) -->
		<div class="pos-cart-panel" style="flex: 4; display: flex; flex-direction: column; height: 100%; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-elev); overflow: hidden;">
			<!-- Customer Selector -->
			<div style="padding: 16px; border-bottom: 1px solid var(--border); background: rgba(0,0,0,0.1);">
				<div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
					<label class="form-label" style="margin: 0; font-weight: 600;">Asociar Cliente</label>
					<button class="btn btn-sm btn-outline" onclick="openNewCustomerModal()" style="height: 28px; padding: 0 10px; font-size: 11px;">+ Nuevo</button>
				</div>
				<div id="customer-search-container" style="position: relative;">
					<input type="text" class="form-input" placeholder="Buscar por Cédula/NIT o Nombre..." id="pos-customer-search" oninput="searchCustomers()" style="width: 100% !important; height: 38px !important; font-size: 13px !important; margin: 0;">
					<div id="customer-search-results" style="display: none; position: absolute; top: calc(100% + 4px); left: 0; right: 0; background: var(--bg-elev); border: 1px solid var(--border-strong); border-radius: 8px; box-shadow: 0 10px 25px rgba(0,0,0,0.3); z-index: 90; max-height: 200px; overflow-y: auto;">
						<!-- Results -->
					</div>
				</div>
				<div id="selected-customer-box" style="display: none; margin-top: 8px; padding: 10px 12px; border-radius: 8px; background: var(--accent-dim); border: 1px solid rgba(59,130,246,0.2); justify-content: space-between; align-items: center;">
					<div style="font-size: 12px;">
						<div style="font-weight: 600; color: var(--text);"><span id="sel-customer-name">Juan Perez</span></div>
						<div style="color: var(--text-sec); margin-top: 2px;">Cédula: <span class="mono" id="sel-customer-id">123456</span></div>
					</div>
					<button class="action-btn" onclick="clearSelectedCustomer()" style="color: var(--danger); width: 24px; height: 24px; display: flex; align-items: center; justify-content: center; font-size: 18px; border: none; background: transparent; cursor: pointer;">&times;</button>
				</div>
			</div>

			<!-- Cart Items List -->
			<div id="cart-items" style="flex: 1; overflow-y: auto; padding: 16px;">
				<div style="text-align: center; padding: 60px 20px; color: var(--text-mut);">
					<svg style="width: 48px; height: 48px; margin: 0 auto 12px auto; opacity: 0.3;" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 00-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 00-16.536-1.84M7.5 14.25L5.106 5.272M6 20.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm12.75 0a.75.75 0 11-1.5 0 .75.75 0 011.5 0z"></path>
					</svg>
					Carrito vacío
				</div>
			</div>

			<!-- Cart Totals & Checkout -->
			<div style="padding: 16px; border-top: 1px solid var(--border); background: rgba(0,0,0,0.15); display: flex; flex-direction: column; gap: 10px;">
				<div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--text-sec);">
					<span>Subtotal</span>
					<span class="mono" id="cart-subtotal">$0</span>
				</div>
				<div style="display: flex; justify-content: space-between; font-size: 13px; color: var(--text-sec);">
					<span>Impuesto (IVA 19%)</span>
					<span class="mono" id="cart-tax">$0</span>
				</div>
				<div style="display: flex; justify-content: space-between; align-items: baseline; border-top: 1px dashed var(--border); padding-top: 10px; margin-top: 4px;">
					<span style="font-size: 15px; font-weight: 600;">Total a pagar</span>
					<span class="mono" id="cart-total" style="font-size: 24px; font-weight: 700; color: var(--success);">$0</span>
				</div>
				<button class="btn btn-primary" onclick="openCheckoutModal()" style="width: 100%; height: 50px; font-size: 15px; font-weight: 600; border-radius: 10px; box-shadow: 0 4px 14px rgba(59, 130, 246, 0.4); margin-top: 8px; justify-content: center; gap: 8px;">
					<svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
					</svg>
					Cobrar (F12)
				</button>
			</div>
		</div>
	</div>

	<!-- MODAL 1: Payment Checkout & Cash Calculator -->
	<div class="modal-overlay" id="checkout-modal" style="z-index: 10000; backdrop-filter: blur(4px); background: rgba(0, 0, 0, 0.6); position: fixed; inset: 0; display: none; align-items: center; justify-content: center;">
		<div class="modal" style="max-width: 700px; width: 90%; border-radius: 16px; border: 1px solid var(--border-strong); box-shadow: 0 24px 38px 3px rgba(0,0,0,0.35); overflow: hidden; background: var(--bg-elev);">
			<div class="modal-header" style="padding: 16px 24px; border-bottom: 1px solid var(--border);">
				<h3 class="modal-title" style="font-size: 18px; font-weight: 700;">Finalizar Venta y Cobro</h3>
				<button class="modal-close" onclick="closeCheckoutModal()" style="font-size: 24px; cursor: pointer; background: none; border: none; color: var(--text-mut);">&times;</button>
			</div>
			<div class="modal-body" style="padding: 24px; display: flex; gap: 24px; flex-wrap: wrap;">
				<!-- Left column: Payment Method selection -->
				<div style="flex: 1; min-width: 240px; display: flex; flex-direction: column; gap: 12px;">
					<h4 style="font-size: 13px; font-weight: 600; color: var(--text-sec); margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px;">Método de Pago</h4>
					
					<button class="pay-method-btn active" id="pay-method-efectivo" onclick="selectPayMethod('efectivo')" style="display: flex; align-items: center; gap: 14px; width: 100%; padding: 16px; border-radius: 12px; border: 2px solid var(--accent); background: var(--accent-dim); color: var(--accent); cursor: pointer; text-align: left; transition: all 0.2s;">
						<span style="font-size: 24px;">💵</span>
						<div>
							<div style="font-weight: 700; font-size: 14px;">Efectivo</div>
							<div style="font-size: 11px; opacity: 0.8;">Caja registradora clásica</div>
						</div>
					</button>

					<button class="pay-method-btn" id="pay-method-tarjeta" onclick="selectPayMethod('tarjeta')" style="display: flex; align-items: center; gap: 14px; width: 100%; padding: 16px; border-radius: 12px; border: 2px solid var(--border); background: var(--bg-surf); color: var(--text-sec); cursor: pointer; text-align: left; transition: all 0.2s;">
						<span style="font-size: 24px;">💳</span>
						<div>
							<div style="font-weight: 700; font-size: 14px;">Tarjeta</div>
							<div style="font-size: 11px; opacity: 0.8;">Datáfono / Datafono inalámbrico</div>
						</div>
					</button>

					<button class="pay-method-btn" id="pay-method-transferencia" onclick="selectPayMethod('transferencia')" style="display: flex; align-items: center; gap: 14px; width: 100%; padding: 16px; border-radius: 12px; border: 2px solid var(--border); background: var(--bg-surf); color: var(--text-sec); cursor: pointer; text-align: left; transition: all 0.2s;">
						<span style="font-size: 24px;">📲</span>
						<div>
							<div style="font-weight: 700; font-size: 14px;">Nequi / Transferencia</div>
							<div style="font-size: 11px; opacity: 0.8;">Banca móvil / QR digital</div>
						</div>
					</button>
				</div>

				<!-- Right column: Cash calculator -->
				<div style="flex: 1.3; min-width: 280px; display: flex; flex-direction: column; gap: 16px;">
					<!-- Total block -->
					<div style="padding: 16px; border-radius: 12px; background: rgba(0,0,0,0.2); border: 1px solid var(--border); text-align: center;">
						<div style="font-size: 12px; color: var(--text-mut); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Total a Cobrar</div>
						<div class="mono" id="modal-total-pay" style="font-size: 32px; font-weight: 800; color: var(--success); margin-top: 4px;">$0</div>
					</div>

					<!-- Cash Register Inputs -->
					<div id="cash-calculator-fields" style="display: flex; flex-direction: column; gap: 12px;">
						<div class="form-group" style="margin: 0;">
							<label class="form-label" style="font-weight: 600;">Efectivo Recibido</label>
							<input type="text" class="form-input mono" id="pay-cash-received" oninput="calculateChange()" placeholder="$0" style="font-size: 18px !important; height: 48px !important; text-align: right; font-weight: bold;">
						</div>

						<!-- Quick Cash Buttons -->
						<div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px;">
							<button class="btn btn-secondary btn-sm" onclick="addQuickCash(5000)" style="font-weight: 600;">$5.000</button>
							<button class="btn btn-secondary btn-sm" onclick="addQuickCash(10000)" style="font-weight: 600;">$10.000</button>
							<button class="btn btn-secondary btn-sm" onclick="addQuickCash(20000)" style="font-weight: 600;">$20.000</button>
							<button class="btn btn-secondary btn-sm" onclick="addQuickCash(50000)" style="font-weight: 600;">$50.000</button>
							<button class="btn btn-secondary btn-sm" onclick="addQuickCash(100000)" style="font-weight: 600;">$100.000</button>
							<button class="btn btn-primary btn-sm" onclick="setExactCash()" style="font-weight: 700;">Exacto</button>
						</div>

						<!-- Change Output Box -->
						<div id="change-box" style="padding: 16px; border-radius: 12px; background: rgba(34, 197, 94, 0.08); border: 1px solid rgba(34, 197, 94, 0.15); text-align: center; margin-top: 4px;">
							<div style="font-size: 11px; color: var(--text-sec); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px;">Cambio (Vueltas)</div>
							<div class="mono" id="modal-change" style="font-size: 28px; font-weight: 800; color: var(--success); margin-top: 4px;">$0</div>
						</div>
					</div>
				</div>
			</div>
			<div class="modal-footer" style="padding: 16px 24px; border-top: 1px solid var(--border);">
				<button class="btn btn-secondary" onclick="closeCheckoutModal()" style="height: 40px; font-weight: 600; padding: 0 20px;">Atrás</button>
				<button class="btn btn-primary" onclick="submitPOSSale()" style="height: 40px; font-weight: 700; padding: 0 24px; background: var(--success);">Completar Venta</button>
			</div>
		</div>
	</div>

	<!-- MODAL 2: Create New Customer (Desktop Form Layout) -->
	<div class="modal-overlay" id="customer-modal" style="z-index: 10001; backdrop-filter: blur(4px); background: rgba(0, 0, 0, 0.6); position: fixed; inset: 0; display: none; align-items: center; justify-content: center;">
		<div class="modal" style="max-width: 580px; width: 90%; border-radius: 16px; border: 1px solid var(--border-strong); box-shadow: 0 24px 38px 3px rgba(0,0,0,0.35); overflow: hidden; background: var(--bg-elev);">
			<div class="modal-header" style="padding: 16px 24px; border-bottom: 1px solid var(--border);">
				<h3 class="modal-title" style="font-size: 18px; font-weight: 700;">Registrar Nuevo Cliente</h3>
				<button class="modal-close" onclick="closeNewCustomerModal()" style="font-size: 24px; cursor: pointer; background: none; border: none; color: var(--text-mut);">&times;</button>
			</div>
			<div class="modal-body" style="padding: 24px;">
				<form id="new-customer-form" onsubmit="submitNewCustomer(event)" style="display: flex; flex-direction: column; gap: 16px;">
					<!-- Row 1: Cedula & Nombre -->
					<div class="form-row" style="display: grid; grid-template-columns: 1fr; gap: 16px;">
						<div class="form-group" style="margin: 0;">
							<label class="form-label" style="font-weight: 600;">Cédula / NIT <span style="color: var(--danger);">*</span></label>
							<input type="text" class="form-input" id="cust-cedula" required placeholder="Ej. 10203040">
						</div>
						<div class="form-group" style="margin: 0;">
							<label class="form-label" style="font-weight: 600;">Nombre Completo / Razón Social <span style="color: var(--danger);">*</span></label>
							<input type="text" class="form-input" id="cust-nombre" required placeholder="Ej. Juan Pérez">
						</div>
					</div>

					<!-- Row 2: Telefono & Email -->
					<div class="form-row" style="display: grid; grid-template-columns: 1fr; gap: 16px;">
						<div class="form-group" style="margin: 0;">
							<label class="form-label" style="font-weight: 600;">Número de Teléfono <span style="color: var(--danger);">*</span></label>
							<input type="tel" class="form-input" id="cust-telefono" required placeholder="Ej. 3001234567">
						</div>
						<div class="form-group" style="margin: 0;">
							<label class="form-label" style="font-weight: 600;">Correo Electrónico <span style="color: var(--danger);">*</span></label>
							<input type="email" class="form-input" id="cust-email" required placeholder="Ej. cliente@correo.com">
						</div>
					</div>
					
					<div style="font-size: 11px; color: var(--text-mut); margin-top: 4px;">
						Los campos marcados con <span style="color: var(--danger);">*</span> son requeridos por la DIAN para facturación electrónica.
					</div>

					<div class="modal-footer" style="padding: 16px 0 0 0; border-top: 1px solid var(--border); display: flex; justify-content: flex-end; gap: 8px; margin-top: 12px;">
						<button type="button" class="btn btn-secondary" onclick="closeNewCustomerModal()" style="height: 40px; font-weight: 600; padding: 0 20px;">Cancelar</button>
						<button type="submit" class="btn btn-primary" style="height: 40px; font-weight: 700; padding: 0 24px;">Registrar y Seleccionar</button>
					</div>
				</form>
			</div>
		</div>
	</div>

	<!-- Custom inline styles for enhancements (loader, animations) -->
	<style>
		@keyframes pulse {
			0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7); }
			70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(34, 197, 94, 0); }
			100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
		}
		@keyframes spin {
			0% { transform: rotate(0deg); }
			100% { transform: rotate(360deg); }
		}
		.pay-method-btn:hover {
			border-color: var(--accent) !important;
			background: var(--bg-hover) !important;
			color: var(--text) !important;
		}
		.pay-method-btn.active {
			border-color: var(--accent) !important;
			background: var(--accent-dim) !important;
			color: var(--accent) !important;
		}
		
		/* Responsive adjustments */
		@media (max-width: 1024px) {
			.pos-container {
				flex-direction: column !important;
				height: auto !important;
				overflow: visible !important;
			}
			.pos-catalog, .pos-cart-panel {
				flex: none !important;
				height: auto !important;
			}
			.pos-cart-panel {
				margin-top: 24px;
			}
		}
		@media (min-width: 600px) {
			#customer-modal .form-row,
			#new-customer-form .form-row {
				grid-template-columns: 1fr 1fr !important;
			}
		}
	</style>

	<script src="/static/js/toast.js"></script>
	<script src="/static/js/pos.js"></script>
}
