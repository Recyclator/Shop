package pages


// LayawaysPage renders the layaways management page
templ LayawaysPage() {
	<div class="page-header">
		<div><h1 class="page-title">Separados</h1><p class="page-sub" id="total-layaways">Cargando...</p></div>
		<button class="btn btn-primary" onclick="openCreateModal()"><svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Nuevo Separado</button>
	</div>
	<div class="toolbar">
		<input type="text" placeholder="Buscar..." id="search-filter">
		<select id="status-filter"><option value="">Todos</option><option value="activo">Activo</option><option value="pagado">Pagado</option><option value="vencido">Vencido</option><option value="cancelado">Cancelado</option></select>
		<button class="btn btn-secondary" onclick="loadLayaways()">Filtrar</button>
		<button class="btn btn-secondary" onclick="checkExpired()" style="margin-left:auto">Verificar Vencidos</button>
	</div>
	<div class="card"><div class="card-body p-0">
		<table><thead><tr><th>Cliente</th><th>Producto</th><th>Total</th><th>Abonado</th><th>Saldo</th><th>Vencimiento</th><th>Estado</th><th>Acciones</th></tr></thead>
		<tbody id="layaways-table"><tr><td colspan="8" style="text-align:center;padding:40px;color:var(--text-mut)">Cargando...</td></tr></tbody></table>
	</div></div>
	<div class="pagination" id="pagination"></div>
	<div class="modal-overlay" id="layaway-modal"><div class="modal">
		<div class="modal-header"><div class="modal-title">Nuevo Separado</div><button class="modal-close" onclick="closeModal()">&times;</button></div>
		<div class="modal-body"><form id="layaway-form">
			<div class="form-group"><label class="form-label">Cliente *</label><select class="form-select" id="lay-customer" required><option value="">Seleccionar...</option></select></div>
			<div class="form-group"><label class="form-label">Producto *</label><select class="form-select" id="lay-product" required><option value="">Seleccionar...</option></select></div>
			<div class="form-row"><div class="form-group"><label class="form-label">Cantidad *</label><input type="number" class="form-input" id="lay-cantidad" min="1" value="1" required></div><div class="form-group"><label class="form-label">Abono Inicial *</label><input type="number" class="form-input" id="lay-abono" min="0" step="0.01" value="0" required></div></div>
		</form></div>
		<div class="modal-footer"><button class="btn btn-secondary" onclick="closeModal()">Cancelar</button><button class="btn btn-primary" onclick="saveLayaway()">Crear</button></div>
	</div></div>
	<div class="modal-overlay" id="payments-modal"><div class="modal">
		<div class="modal-header"><div class="modal-title">Historial de Abonos</div><button class="modal-close" onclick="closePaymentsModal()">&times;</button></div>
		<div class="modal-body">
			<div id="payment-details"></div>
			<div style="padding:16px;background:var(--bg-surf);border-radius:8px;text-align:center;margin:16px 0;"><div style="font-size:12px;color:var(--text-mut)">Saldo Pendiente</div><div class="mono" style="font-size:24px;font-weight:600;" id="balance-amount">$0</div></div>
			<div class="form-group"><label class="form-label">Nuevo Abono</label><input type="number" class="form-input" id="payment-amount" min="0.01" step="0.01" placeholder="Monto..."></div>
			<div id="payments-list" style="max-height:300px;overflow-y:auto;"></div>
		</div>
		<div class="modal-footer"><button class="btn btn-secondary" onclick="closePaymentsModal()">Cerrar</button><button class="btn btn-primary" onclick="addPayment()">Registrar Abono</button></div>
	</div></div>
	<script src="/public/toast.js"></script>
	<script src="/static/js/layaways.js"></script>
}
