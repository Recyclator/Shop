# ===========================================
# NEXORA E-COMMERCE BACKEND - DOCKER ENVIRONMENT
# ===========================================

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=nexora

# JWT Authentication
JWT_SECRET=change-me-256-bit-secret-key-minimum-length-required
JWT_EXPIRE_HOURS=168

# Application
ENV=development
SERVER_PORT=3000
QR_BASE_URL=https://nexora.co/qr
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:3000

# Casbin
CASBIN_MODEL_PATH=pkg/casbin/model.conf
CASBIN_POLICY_PATH=pkg/casbin/policy.csv

# Initial Admin (opcional - solo para desarrollo)
INITIAL_ADMIN_PASSWORD=change-me-admin-password-only-for-dev
