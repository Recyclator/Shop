# ===========================================
# NEXORA E-COMMERCE BACKEND - CONFIGURATION
# ===========================================

# Server
SERVER_PORT=3000
ENV=development

# Database PostgreSQL (DigitalOcean)
DB_HOST=your-db-host.ondigitalocean.com
DB_PORT=5432
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_NAME=nexora
DB_SSL_MODE=require

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRE_HOURS=168  # 7 days

# Casbin
CASBIN_MODEL_PATH=internal/casbin/model.conf
CASBIN_POLICY_PATH=internal/casbin/policy.csv

# Application
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173

# QR Code
QR_BASE_URL=https://nexora.co/qr
