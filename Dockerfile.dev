FROM golang:1.21-alpine

WORKDIR /app

# Instalar herramientas de desarrollo
RUN apk add --no-cache git make gcc musl-dev

# Instalar Air para hot reload
RUN go install github.com/cosmtrek/air@latest

# Copiar go mod
COPY go.mod go.sum ./
RUN go mod download

# Copiar código
COPY . .

EXPOSE 3000

# Ejecutar con Air
CMD ["air"]
